APP_ENV=development
HTTP_ADDR=:8081
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

POSTGRES_USER=martgo_auth
POSTGRES_PASSWORD=martgo_auth
POSTGRES_DB=martgo_auth
POSTGRES_PORT=5434
DATABASE_URL=postgres://martgo_auth:martgo_auth@localhost:5434/martgo_auth?sslmode=disable

# Shared with mart-api (Redis runs from mart-api's docker-compose)
REDIS_URL=redis://localhost:6380/0

# Generate with:
#   openssl genpkey -algorithm ed25519 -out keys/jwt_private.pem
#   openssl pkey -in keys/jwt_private.pem -pubout -out keys/jwt_public.pem
# Copy only jwt_public.pem to mart-api.
JWT_PRIVATE_KEY_FILE=keys/jwt_private.pem
JWT_TTL=24h

# Used by the seed migration to create the default admin
ADMIN_EMAIL=admin@martgo.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrator

# SMS login codes: users with a phone must enter a code sent by SMS after their password.
#   log    = print the SMS to the server log (development only, refused when APP_ENV=production)
#   telbiz = send through https://telbiz.la (client ID and secret from your Telbiz account)
SMS_PROVIDER=log
TELBIZ_URL=https://api.telbiz.la
TELBIZ_CLIENT_ID=
TELBIZ_SECRET=

# Set to true only when running behind a proxy you control (the gateway)
TRUST_PROXY=false
# Set to false in production to hide /docs
ENABLE_DOCS=true

# Login with Google (optional). Leave GOOGLE_CLIENT_ID empty to turn it off.
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# and add GOOGLE_REDIRECT_URL to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8081/api/v1/auth/google/callback
# Only allow accounts of this Google Workspace domain, e.g. martgo.la (empty = any verified Google account)
GOOGLE_ALLOWED_DOMAIN=
# Frontend page that finishes the login: gets ?code=... (or ?error=...) after Google
OAUTH_FRONTEND_URL=http://localhost:3000/auth/google/done